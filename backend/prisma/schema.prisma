// Children's Happy Home (CHH) School Management System - Prisma Schema
// Relational & Transactional Database: PostgreSQL (Neon / Managed Postgres)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- 1. ACADEMIC STRUCTURE ----------------

model AcademicYear {
  id            String         @id @default(uuid())
  name          String         @unique // e.g. "2026-2027"
  startDate     DateTime
  endDate       DateTime
  isCurrent     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  students      Student[]
  feeStructures FeeStructure[]
  feeInvoices   FeeInvoice[]
  exams         Exam[]

  @@map("academic_years")
}

model Class {
  id            String         @id @default(uuid())
  name          String         @unique // e.g. "Class X", "Nursery"
  stage         String         // "Pre-Primary", "Primary", "Middle", "Secondary", "Senior Secondary"
  orderIndex    Int            @default(0) // for sorted display
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  sections      Section[]
  students      Student[]
  feeStructures FeeStructure[]
  exams         Exam[]
  attendances   Attendance[]

  @@map("classes")
}

model Section {
  id          String       @id @default(uuid())
  name        String       // e.g. "A", "B", "C"
  classId     String
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  capacity    Int          @default(40)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  students    Student[]
  attendances Attendance[]

  @@unique([classId, name])
  @@map("sections")
}

// ---------------- 2. STUDENT ACADEMIC REGISTRY ----------------

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED
  EXPELLED
}

model Student {
  id             String        @id @default(uuid())
  enrollmentNo   String        @unique // e.g. "CHH2026-001"
  admissionNo    String        @unique // e.g. "ADM-2026-104"
  rollNo         Int?
  mongoUserId    String?       // Reference to MongoDB User / Profile ID
  
  academicYearId String
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id])
  
  classId        String
  class          Class         @relation(fields: [classId], references: [id])
  
  sectionId      String
  section        Section       @relation(fields: [sectionId], references: [id])
  
  status         StudentStatus @default(ACTIVE)
  admissionDate  DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  invoices       FeeInvoice[]
  payments       FeePayment[]
  attendances    Attendance[]
  marks          MarksRecord[]

  @@map("students")
}

// ---------------- 3. FINANCIAL & TRANSACTIONAL ENGINE ----------------

model FeeStructure {
  id                 String       @id @default(uuid())
  classId            String
  class              Class        @relation(fields: [classId], references: [id])
  
  academicYearId     String
  academicYear       AcademicYear @relation(fields: [academicYearId], references: [id])
  
  admissionFee       Decimal      @db.Decimal(10, 2) // One-time
  annualCharges      Decimal      @db.Decimal(10, 2) // Annual maintenance/activity
  monthlyTuitionFee  Decimal      @db.Decimal(10, 2) // Monthly
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([classId, academicYearId])
  @@map("fee_structures")
}

enum InvoiceStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

model FeeInvoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique // e.g. "INV-2026-09-001"
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id])
  
  academicYearId String
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id])
  
  month          String        // e.g. "September 2026"
  totalAmount    Decimal       @db.Decimal(10, 2)
  paidAmount     Decimal       @default(0.00) @db.Decimal(10, 2)
  dueAmount      Decimal       @db.Decimal(10, 2)
  dueDate        DateTime
  status         InvoiceStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  payments       FeePayment[]

  @@map("fee_invoices")
}

enum PaymentMode {
  CASH
  ONLINE
  UPI
  CHEQUE
  BANK_TRANSFER
}

enum PaymentStatus {
  SUCCESS
  FAILED
  REFUNDED
}

model FeePayment {
  id            String        @id @default(uuid())
  receiptNumber String        @unique // e.g. "RCPT-2026-0042"
  invoiceId     String
  invoice       FeeInvoice    @relation(fields: [invoiceId], references: [id])
  
  studentId     String
  student       Student       @relation(fields: [studentId], references: [id])
  
  amountPaid    Decimal       @db.Decimal(10, 2)
  paymentMode   PaymentMode   @default(CASH)
  transactionId String?       // Gateway or UPI UTR reference
  status        PaymentStatus @default(SUCCESS)
  paymentDate   DateTime      @default(now())
  receivedBy    String?       // Staff user reference
  receiptPdfUrl String?       // Cloudinary receipt PDF link
  remarks       String?
  createdAt     DateTime      @default(now())

  @@map("fee_payments")
}

// ---------------- 4. ATTENDANCE & LOGS ----------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
}

model Attendance {
  id        String           @id @default(uuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id])
  
  classId   String
  class     Class            @relation(fields: [classId], references: [id])
  
  sectionId String
  section   Section          @relation(fields: [sectionId], references: [id])
  
  date      DateTime         @db.Date
  status    AttendanceStatus @default(PRESENT)
  remarks   String?
  createdAt DateTime         @default(now())

  @@unique([studentId, date])
  @@map("attendances")
}

// ---------------- 5. EXAMINATIONS & GRADING ----------------

model Exam {
  id             String        @id @default(uuid())
  title          String        // e.g. "Half-Yearly Examination 2026", "Periodic Test 1"
  academicYearId String
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id])
  
  classId        String
  class          Class         @relation(fields: [classId], references: [id])
  
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  marks          MarksRecord[]

  @@map("exams")
}

model MarksRecord {
  id            String   @id @default(uuid())
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id])
  
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  
  subjectName   String   // e.g. "Mathematics", "Science"
  theoryMarks   Decimal  @db.Decimal(5, 2)
  practicalMarks Decimal @default(0.00) @db.Decimal(5, 2)
  totalMarks    Decimal  @db.Decimal(5, 2)
  maxMarks      Decimal  @db.Decimal(5, 2)
  grade         String?  // "A1", "A2", "B1", etc.
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([examId, studentId, subjectName])
  @@map("marks_records")
}
